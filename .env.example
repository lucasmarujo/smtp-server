# ---------------------------------------------------------------------------
# Imagem / identidade do servidor
# ---------------------------------------------------------------------------
DMS_IMAGE=mailserver/docker-mailserver:15.1.0
MAIL_HOSTNAME=mail.marujo.dev
MAIL_DOMAIN=marujo.dev
POSTMASTER_ADDRESS=hi@marujo.dev
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# TLS
#   self-signed -> certificado temporario (uso inicial / testes locais)
#   manual      -> usa o certificado emitido pelo Caddy do host (producao)
# ---------------------------------------------------------------------------
SSL_TYPE=self-signed
SSL_CERT_PATH=/caddy-certs/acme-v02.api.letsencrypt.org-directory/mail.marujo.dev/mail.marujo.dev.crt
SSL_KEY_PATH=/caddy-certs/acme-v02.api.letsencrypt.org-directory/mail.marujo.dev/mail.marujo.dev.key
TLS_LEVEL=intermediate

# ---------------------------------------------------------------------------
# Antispam / recursos
# ---------------------------------------------------------------------------
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
RSPAMD_CHECK_AUTHENTICATED=0
RSPAMD_GREYLISTING=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_CLAMAV=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_FAIL2BAN=1
ENABLE_UPDATE_CHECK=0

# ---------------------------------------------------------------------------
# Politicas de seguranca / relay
# ---------------------------------------------------------------------------
PERMIT_DOCKER=none
SPOOF_PROTECTION=1
POSTSCREEN_ACTION=enforce
ONE_DIR=1
LOG_LEVEL=info
POSTFIX_MESSAGE_SIZE_LIMIT=52428800

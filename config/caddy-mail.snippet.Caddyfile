# ---------------------------------------------------------------------------
# Blocos adicionados ao /opt/proxy/Caddyfile (secao "MAIL").
#
#   mail.marujo.dev     -> so existe para o Caddy emitir/renovar o certificado
#                          Let's Encrypt que o Postfix/Dovecot usam
#                          (o container mail le em /caddy-certs/, ro).
#   webmail.marujo.dev  -> Roundcube (container 'roundcube', rede 'proxy').
#
# O Caddyfile e um bind-mount de arquivo unico; editores que reescrevem o
# arquivo trocam o inode e o `caddy reload` NAO pega a mudanca. Use:
#   docker restart caddy          (~1s de indisponibilidade no proxy)
#
# STATUS: aplicado em 2026-08-27. .env em SSL_TYPE=manual, certs LE ativos
# para mail.marujo.dev e webmail.marujo.dev.
# ---------------------------------------------------------------------------

mail.marujo.dev {
	respond "marujo.dev mail server" 200
}

webmail.marujo.dev {
	encode zstd gzip
	reverse_proxy roundcube:80
}
